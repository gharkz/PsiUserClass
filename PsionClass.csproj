<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><LangVersion>latest</LangVersion>
    <Authors>gharkz</Authors><Version>0.2.3</Version>
    <AssemblyName>PsionClass</AssemblyName><RootNamespace>PsionClass</RootNamespace>
    <ElinGamePath Condition="'$(ElinGamePath)' == ''">X:/SteamLibrary/steamapps/common/Elin</ElinGamePath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>dist/PsionClass/</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile><DebugType>none</DebugType>
    <Deterministic>true</Deterministic><PathMap>$(MSBuildProjectDirectory)=/src/PsionClass</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="$(ElinGamePath)/Elin_Data/Managed/Elin.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/Elin_Data/Managed/Plugins.UI.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/Elin_Data/Managed/Plugins.BaseCore.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/Elin_Data/Managed/Plugins.Sound.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/Elin_Data/Managed/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/Elin_Data/Managed/UnityEngine.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/Elin_Data/Managed/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/Elin_Data/Managed/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/Elin_Data/Managed/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/Elin_Data/Managed/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/Elin_Data/Managed/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/BepInEx/core/BepInEx.Unity.dll" Private="false" />
    <Reference Include="$(ElinGamePath)/BepInEx/core/0Harmony.dll" Private="false" />
    <None Include="LangMod/**/*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/psishield.png;assets/psiteleport.png;assets/psihurl.png;assets/psistrike.png" CopyToOutputDirectory="PreserveNewest" LinkBase="assets" />
    <None Include="package.xml;preview.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
